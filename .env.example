APP_NAME=SIH 2026 GenAI Platform
APP_ENV=development
DEBUG=True

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sih_genai

# Development placeholder — MUST be replaced with a strong secret in production
# (>= 32 random characters). The application refuses to start in production
# without a sufficiently long JWT_SECRET_KEY.
JWT_SECRET_KEY=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Local filesystem directory where uploaded source documents (input files)
# are stored. Relative paths resolve against the application working directory.
UPLOAD_DIR=./uploads
# Maximum size for a single uploaded input file (bytes). Default: 25 MiB.
MAX_UPLOAD_SIZE_BYTES=26214400